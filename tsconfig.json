{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,

    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],

    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,

    "jsx": "react-jsx",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,

    "allowJs": true,
    "checkJs": false
  },

  "include": [
    "src"
  ]
}